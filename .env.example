# Cloudflare Workers env vars
# Copy to .dev.vars for local Wrangler dev

# ── Better Auth ────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5173
# Production URL: https://wedontneednukes.org

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
# Create app at: https://github.com/settings/apps/new
# Dev callback:  http://localhost:5173/api/auth/callback/github
# Prod callback: https://wedontneednukes.org/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Dev callback:  http://localhost:5173/api/auth/callback/google
# Prod callback: https://wedontneednukes.org/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ── Email / Magic Link (Optional in dev, required in prod) ─────────────────────
# If not set in local development, links are logged to the console
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=WeDon't Need Nukes <noreply@wedontneednukes.org>

# ── Drizzle Kit (for remote D1 studio/migrations only) ────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_TOKEN=your_cloudflare_api_token
