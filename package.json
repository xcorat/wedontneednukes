		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@cloudflare/workers-types": "^4.20250909.0",
		"@tailwindcss/vite": "^4.1.11",
		"drizzle-kit": "^0.31.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.1.11",
