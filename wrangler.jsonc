{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wedontneednukes",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wedontneednukes-db",
			"database_id": "71ee76e9-ac81-4c66-b18c-4aaca12345e4"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// Environment variables can be configured here or in Cloudflare dashboard
	"vars": {}
}
