{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wedontneednukes",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wedontneednukes-db",
			"database_id": "71ee76e9-ac81-4c66-b18c-4aaca12345e4",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// Environment variables can be configured here or in Cloudflare dashboard
	"vars": {
    "BETTER_AUTH_URL": "https://wedontneednukes.org",
    "FACEBOOK_APP_ID": "1059794736968380",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEx_YB7mO4Q24vS9",
    "TWITTER_CLIENT_ID": "ejN3VXFUTXlQYnRLQ3c1Q3lfZmg6MTpjaQ",
    "OPENAI_VECTOR_STORE_ID":"vs_6aacac96299c8191b93d9c1afc0d11c3"
  }
	// Edge Security & Rate Limiting:
	// - Apply Cloudflare WAF rate limiting rules on the zone:
	//   * Route: /api/auth/* -> Threshold: 15 requests per minute per IP action: Block or Managed Challenge.
	//   * Bot Management: Cloudflare Turnstile token verified on /api/auth/sign-in/* and form submissions.
	//   * DDOS: Cloudflare HTTP DDoS Attack Protection enabled by default.

  // TODO: enable only when debugging.
  //
  //   "observability": {
  //     "logs": {
  //       "enabled": true,
  //       "head_sampling_rate": 1,
  //       "invocation_logs": true,
  //       "persist": true
  //     },
  //     "traces": {
  //       "enabled": false,
  //       "head_sampling_rate": 1,
  //       "persist": true
  //     }
  //   }
//
}
